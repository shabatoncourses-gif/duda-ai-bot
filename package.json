{
  "name": "duda-ai-bot",
  "version": "2.0.0",
  "description": "Automated content indexing bot for Shabaton & Morim with enhanced Hebrew support",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "start": "vercel dev",
    "index": "node scripts/autoBuildIndex.js",
    "build-index": "node scripts/autoBuildIndex.js",
    "build-shabaton": "node scripts/autoBuildIndex.js Shabaton https://www.shabaton.online/sitemap.xml",
    "build-morim": "node scripts/autoBuildIndex.js Morim https://www.morim.boutique/sitemap.xml",
    "test-index": "node scripts/autoBuildIndex.js Shabaton https://www.shabaton.online/sitemap.xml"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "openai": "^4.70.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.5",
    "raw-body": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0"
  },
  "vercel": {
    "functions": {
      "api/chat.js": {
        "maxDuration": 120,
        "memory": 512
      },
      "api/build-index.js": {
        "maxDuration": 300,
        "memory": 1024
      }
    }
  }
}
