{
  "version": 2,
  "builds": [
    { "src": "pages/api/chat.js", "use": "@vercel/node" },
    { "src": "pages/api/reindex.js", "use": "@vercel/node" },
    { "src": "pages/api/status.js", "use": "@vercel/node" },
    { "src": "pages/api/ai_chat_v2.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/api/ai_chat_v2",
      "methods": ["OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "continue": true
    },
    { "src": "/api/ai_chat_v2", "dest": "/pages/api/ai_chat_v2.js" },
    { "src": "/api/chat", "dest": "/pages/api/chat.js" },
    { "src": "/api/reindex", "dest": "/pages/api/reindex.js" },
    { "src": "/api/status", "dest": "/pages/api/status.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
